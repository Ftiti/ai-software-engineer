# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Precedence: real environment variable > .env > default in app/config/settings.py

# Active LLM provider: ollama | openai | gemini | groq
LLM_PROVIDER=ollama

# Defaults shared by every provider
LLM_TEMPERATURE=0.0
# Request timeout in seconds. Leave unset for no limit (local CPU models can be slow).
# LLM_TIMEOUT=120

# Ollama (local, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TEMPERATURE=        # overrides LLM_TEMPERATURE for Ollama only

# OpenAI   (key needed only when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=

# Google Gemini   (key needed only when LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=

# Groq   (key needed only when LLM_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TEMPERATURE=

# Tools
TOOL_TIMEOUT=60

# Filesystem capability: the only directory tools may access, and its rules
FS_WORKSPACE_ROOT=.
FS_READ_ONLY=false
# FS_MAX_READ_BYTES=1048576
# FS_MAX_WRITE_BYTES=1048576
# FS_MAX_LIST_ENTRIES=1000
# JSON lists; patterns match any path component
# FS_DENIED_PATTERNS=[".env", ".env.local", ".env.*.local", "*.pem", "*.key", "id_rsa*", "id_ed25519*"]
# FS_PROTECTED_PATTERNS=[".git"]

# Code intelligence: maximum results returned by one search or navigation query
# CODE_MAX_RESULTS=50

# Terminal capability: commands run without a shell, inside FS_WORKSPACE_ROOT
# TERMINAL_ENABLED=true
# JSON lists. "*" in the allowed list allows every program that is not denied.
# TERMINAL_ALLOWED_COMMANDS=["python", "python3", "pytest", "ruff", "mypy", "make", "npm", "node", "composer", "php", "ls", "pwd", "echo"]
# TERMINAL_DENIED_COMMANDS=["git", "rm", "sudo", "curl", "bash", ...]   (see app/config/settings.py)
# TERMINAL_ALLOWED_SUBCOMMANDS={"npm": ["install", "test", "run"], "composer": ["install", "test"]}
# Seconds. TERMINAL_MAX_TIMEOUT must stay below TOOL_TIMEOUT.
# TERMINAL_DEFAULT_TIMEOUT=30
# TERMINAL_MAX_TIMEOUT=50
# TERMINAL_MAX_OUTPUT_BYTES=64000
# TERMINAL_PYTHON=python3

# Git capability: repositories inside FS_WORKSPACE_ROOT, no reset/clean/rebase/force, secrets never staged
# GIT_ENABLED=true
# GIT_ALLOW_PUSH=false             # git_push is offered to the agent only when true (never forced)
# GIT_PROTECTED_BRANCHES=[]        # e.g. ["main", "master"]: git_push refuses them
# GIT_ALLOW_HOOKS=true
# Seconds; both must stay below TOOL_TIMEOUT
# GIT_TIMEOUT=30
# GIT_NETWORK_TIMEOUT=50
# GIT_MAX_OUTPUT_BYTES=64000
# GIT_MAX_LOG_ENTRIES=100

# MCP servers definition file (see mcp_servers.example.json)
MCP_CONFIG_PATH=mcp_servers.json
